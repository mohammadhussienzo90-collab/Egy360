# =============================================================================
# Egy360 Production Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
#
# For Railway deployment, add these variables in the Railway dashboard:
# Project > Variables > Add Variable

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secret-key-here-change-this

# Set to False in production
DEBUG=False

# Comma-separated list of allowed hosts (your domain names)
ALLOWED_HOSTS=360egy.com,www.360egy.com,360egy.up.railway.app

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
# Format: postgresql://username:password@host:port/database_name
# Railway provides this automatically
DATABASE_URL=postgresql://user:password@localhost:5432/egy360

# =============================================================================
# EMAIL SETTINGS (Required for production)
# =============================================================================
# Option 1: Gmail SMTP (recommended for starting)
# 1. Enable 2FA: https://myaccount.google.com/security
# 2. Generate App Password: https://myaccount.google.com/apppasswords
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password

# Option 2: SendGrid (for higher volume)
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=SG.your-sendgrid-api-key

# Option 3: Mailgun (custom domain email)
# EMAIL_HOST=smtp.mailgun.org
# EMAIL_HOST_USER=postmaster@mg.360egy.com
# EMAIL_HOST_PASSWORD=your-mailgun-password

# From email addresses
DEFAULT_FROM_EMAIL=Egy360 <noreply@360egy.com>
SERVER_EMAIL=errors@360egy.com
ADMIN_EMAIL=admin@360egy.com

# =============================================================================
# OAUTH - GOOGLE LOGIN
# =============================================================================
# Setup: https://console.cloud.google.com/apis/credentials
# 1. Create project > Configure OAuth consent screen
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Authorized redirect URI: https://360egy.com/accounts/google/login/callback/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# OAUTH - FACEBOOK LOGIN
# =============================================================================
# Setup: https://developers.facebook.com/apps/
# 1. Create App (Consumer type)
# 2. Add Facebook Login product
# 3. Valid OAuth redirect URI: https://360egy.com/accounts/facebook/login/callback/
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# =============================================================================
# OAUTH - APPLE LOGIN (Optional)
# =============================================================================
# Requires Apple Developer account ($99/year)
# Setup: https://developer.apple.com/account/resources/identifiers/
# APPLE_CLIENT_ID=your-apple-client-id
# APPLE_SECRET=your-apple-secret
# APPLE_KEY_ID=your-apple-key-id
# APPLE_PRIVATE_KEY=your-apple-private-key

# =============================================================================
# PAYMOB PAYMENT GATEWAY (Egypt)
# =============================================================================
# Setup: https://accept.paymob.com/portal2/en/login
# Documentation: https://docs.paymob.com/
# Supports: Cards, Mobile Wallets (Vodafone Cash, Orange), Fawry

# API Key: Dashboard > Settings > Account Info
PAYMOB_API_KEY=your-paymob-api-key

# HMAC Secret: Dashboard > Settings > Account Info
PAYMOB_HMAC_SECRET=your-hmac-secret

# Integration IDs: Dashboard > Developers > Payment Integrations
PAYMOB_CARD_INTEGRATION_ID=your-card-integration-id
PAYMOB_WALLET_INTEGRATION_ID=your-wallet-integration-id
PAYMOB_FAWRY_INTEGRATION_ID=your-fawry-integration-id

# iFrame ID: Dashboard > Developers > iframes
PAYMOB_IFRAME_ID=your-iframe-id

# =============================================================================
# STRIPE (International Payments - Optional)
# =============================================================================
# Setup: https://dashboard.stripe.com/
# STRIPE_PUBLIC_KEY=pk_live_your_stripe_public_key
# STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# =============================================================================
# TWILIO SMS (for OTP/2FA)
# =============================================================================
# Setup: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# =============================================================================
# CORS & CSRF
# =============================================================================
CORS_ALLOWED_ORIGINS=https://360egy.com,https://www.360egy.com
CSRF_TRUSTED_ORIGINS=https://360egy.com,https://www.360egy.com

# =============================================================================
# CLOUD STORAGE (Optional - for media files)
# =============================================================================
# AWS S3
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_STORAGE_BUCKET_NAME=egy360-media
# AWS_S3_REGION_NAME=eu-west-1

# Cloudinary (Alternative to S3)
# CLOUDINARY_CLOUD_NAME=your_cloudinary_name
# CLOUDINARY_API_KEY=your_cloudinary_key
# CLOUDINARY_API_SECRET=your_cloudinary_secret

# =============================================================================
# OTHER API KEYS
# =============================================================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# =============================================================================
# SSL & SECURITY (Production)
# =============================================================================
SECURE_SSL_REDIRECT=True
