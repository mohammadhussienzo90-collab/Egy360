# Egy360 Production Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ====================
# SECURITY SETTINGS
# ====================
# Generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-super-secret-key-here-change-this

# Set to False in production
DEBUG=False

# Comma-separated list of allowed hosts (your domain names)
ALLOWED_HOSTS=360egy.com,www.360egy.com,360egy.up.railway.app

# ====================
# DATABASE
# ====================
# Format: postgresql://username:password@host:port/database_name
# Example: postgresql://egyuser:password123@localhost:5432/egy360_db
DATABASE_URL=postgresql://user:password@localhost:5432/egy360

# ====================
# EMAIL SETTINGS
# ====================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=Egy360 <noreply@yourdomain.com>

# ====================
# CORS & CSRF
# ====================
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=https://360egy.com,https://www.360egy.com
CSRF_TRUSTED_ORIGINS=https://360egy.com,https://www.360egy.com

# ====================
# REDIS (Caching & Celery)
# ====================
REDIS_URL=redis://localhost:6379/0

# ====================
# PAYMENT GATEWAYS
# ====================
# Stripe
STRIPE_PUBLIC_KEY=pk_live_your_stripe_public_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key

# Fawry (Egyptian payment gateway)
FAWRY_MERCHANT_CODE=your_fawry_merchant_code
FAWRY_SECURITY_KEY=your_fawry_security_key

# ====================
# CLOUD STORAGE (Optional - for media files)
# ====================
# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_STORAGE_BUCKET_NAME=egy360-media
AWS_S3_REGION_NAME=us-east-1

# Cloudinary (Alternative to S3)
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# ====================
# API KEYS
# ====================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ====================
# SSL & SECURITY
# ====================
SECURE_SSL_REDIRECT=True
